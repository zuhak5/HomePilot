# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/android/build/
/android/.kotlin/
/coverage/
/test/failures/
/.tmp-homepilot-build/
/.tmp-*
/artifacts/
/output/
/dist/
/*.zip
/.agents/
/.codex-remote-attachments/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing secrets
/android/key.properties
/android/app/*.jks
/android/app/*.keystore
/android/app/*.p12
/android/app/google-services.json
/android/app/src/*/google-services.json

# JavaScript tooling
/node_modules/

# Generated public browser config. It contains no service-role secret, but is
# produced from protected deployment settings so each environment stays explicit.
/download-site/account-deletion-config.js

# Supabase CLI state
/supabase/.temp/
/supabase/.branches/

# Local build configuration. Commit examples only.
/config/*.json
!/config/*.example.json
/.env
/.env.*
/supabase/.env
!/supabase/.env.example

# JavaScript dependencies
node_modules/
